datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  title     String?
  username  String?
  avatar    String?
  role      String   @default("Admin")
  theme     String   @default("light")
  colorMode String   @default("blue")
  createdAt DateTime @default(now())
}

model Workspace {
  id        String    @id @default(uuid())
  name      String
  ownerId   String?
  projects  Project[]
  tasks     Task[]
  createdAt DateTime  @default(now())
}

model Project {
  id          String   @id @default(uuid())
  name        String
  priority    String   @default("Medium")
  lead        String?
  dueDate     String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime @default(now())
}

model Task {
  id             String        @id @default(uuid())
  title          String
  description    String?
  status         String        @default("To Do") // "To Do", "Doing", "Completed", "On Hold"
  priority       String        @default("Medium") // "No Priority", "Urgent", "High", "Medium", "Low"
  dueDate        String?
  assigneeName   String?
  assigneeRole   String?
  assigneeAvatar String?
  labels         String?       // JSON or comma separated string e.g. "Research,Design,Development"
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subtasks       Subtask[]
  comments       Comment[]
  activityLogs   ActivityLog[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Subtask {
  id             String   @id @default(uuid())
  title          String
  status         String   @default("To Do")
  priority       String   @default("Medium")
  dueDate        String?
  assigneeName   String?
  assigneeAvatar String?
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model Comment {
  id           String   @id @default(uuid())
  content      String
  authorName   String
  authorAvatar String?
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
